[Unit]
Description=Private Provider Broker
After=network-online.target cpa-manager.service provider-broker-firewall.service
Wants=network-online.target
Requires=provider-broker-firewall.service

[Service]
Type=simple
User=yosef
Group=yosef
WorkingDirectory=/data/provider-broker/current
EnvironmentFile=/data/provider-broker/secrets/broker.env
ExecStart=/data/provider-broker/current/venv/bin/python -m provider_broker
Restart=on-failure
RestartSec=3
TimeoutStopSec=360s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/provider-broker/data

[Install]
WantedBy=multi-user.target
